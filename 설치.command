#!/bin/bash
# ------------------------------------------------------------
#  야외 봉사 집단 배포본 — 설치 도우미 실행 파일 (macOS)
#  Finder에서 두 번 클릭하면 터미널이 열리고 설치 도우미가 시작됩니다.
#  처음 한 번만 실행환경(포터블 Node + 도구)을 내려받고, 이후에는 바로 열립니다.
#  "확인되지 않은 개발자" 경고가 뜨면: 파일을 우클릭 → 열기 → 열기.
#  그래도 안 되면 터미널에서:  bash "설치.command"
# ------------------------------------------------------------
cd "$(dirname "$0")" || exit 1
exec /bin/bash "./installer/bootstrap.sh" "$@"
