#!/bin/bash
# ------------------------------------------------------------
#  야외 봉사 집단 배포본 — 업데이트 실행 파일 (macOS)
#  GitHub 에서 최신 배포본을 받아 프로그램 파일만 교체하고(설정·키·데이터는 유지),
#  설치 도우미 화면을 열어 [다시 배포] 한 번으로 서버와 사이트를 갱신합니다.
#  "확인되지 않은 개발자" 경고가 뜨면: 파일을 우클릭 → 열기 → 열기.
# ------------------------------------------------------------
cd "$(dirname "$0")" || exit 1
exec /bin/bash "./installer/bootstrap.sh" --update "$@"
